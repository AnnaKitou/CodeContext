# ── Project ───────────────────────────────────────────────────────────────────
PROJECT_NAME=CodeContext
ENVIRONMENT=local           # local | staging | production

# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=changethis
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Embeddings ─────────────────────────────────────────────────────────────────
# Available models:
#   - HuggingFace: all-MiniLM-L6-v2, all-mpnet-base-v2, distilbert-base-uncased, etc.
#   - Anthropic:   text-embedding-3-small, text-embedding-3-large
#   - OpenAI:      text-embedding-3-small, text-embedding-3-large
# Auto-detected by model name. Requires ANTHROPIC_API_KEY for Anthropic embeddings,
# OPENAI_API_KEY for OpenAI embeddings. Falls back to HuggingFace if API key missing.
EMBEDDER_MODEL=all-MiniLM-L6-v2
OPENAI_API_KEY=                # sk-… — only needed for OpenAI embeddings

# ── GitHub (for MCP tools) ────────────────────────────────────────────────────
GITHUB_TOKEN=                # ghp_… — leave blank to disable MCP
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_URL=

# ── FastAPI ───────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
FRONTEND_HOST=http://localhost:7860
BACKEND_CORS_ORIGINS=http://localhost:7860,http://localhost:3000

# ── Sentry (optional — leave blank to disable) ────────────────────────────────
SENTRY_DSN=

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
CHROMA_PERSIST=true

# ── RAG ───────────────────────────────────────────────────────────────────────
RETRIEVER_TOP_K=5
RETRIEVER_SCORE_THRESHOLD=0.3
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=200
MAX_CHUNK_SIZE=1000

# ── Features ──────────────────────────────────────────────────────────────────
USE_MCP=true
USE_SEMANTIC_CHUNKING=true
