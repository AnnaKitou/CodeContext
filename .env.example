# ── Project ───────────────────────────────────────────────────────────────────
PROJECT_NAME=CodeContext
ENVIRONMENT=local           # local | staging | production

# ── Anthropic API ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=changethis
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── GitHub (for MCP tools) ────────────────────────────────────────────────────
GITHUB_TOKEN=                # ghp_… — leave blank to disable MCP
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_REPO_URL=

# ── FastAPI ───────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── CORS (comma-separated list of allowed origins) ────────────────────────────
FRONTEND_HOST=http://localhost:7860
BACKEND_CORS_ORIGINS=http://localhost:7860,http://localhost:3000

# ── Sentry (optional — leave blank to disable) ────────────────────────────────
SENTRY_DSN=

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./chroma_db
CHROMA_PERSIST=true

# ── RAG ───────────────────────────────────────────────────────────────────────
RETRIEVER_TOP_K=5
RETRIEVER_SCORE_THRESHOLD=0.3
CHUNK_OVERLAP=100
MIN_CHUNK_SIZE=200
MAX_CHUNK_SIZE=1000

# ── Features ──────────────────────────────────────────────────────────────────
USE_MCP=true
USE_SEMANTIC_CHUNKING=true
